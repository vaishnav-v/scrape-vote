# ==============================================================================
# Kerala SEC Voter List Scraper - Environment Configuration
# ==============================================================================

# Server
PORT=3000
HOST=0.0.0.0

# Worker Pool & Scaling
CONCURRENCY_LIMIT=3
STAGGER_MIN_MS=1000
STAGGER_MAX_MS=3000
MAX_TASK_RETRIES=2
BROWSER_RECYCLE_AFTER=50

# Playwright Browser
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAV_TIMEOUT_MS=60000
RESULT_WAIT_TIMEOUT_MS=60000
BLOCK_NON_ESSENTIAL_ASSETS=true

# EasyOCR Captcha Solver
OCR_ENABLED=true
# Set OCR_USE_WSL=true on Windows if EasyOCR is installed inside WSL instead of native Python
OCR_USE_WSL=false
PYTHON_BIN=python3
OCR_PIPE_TIMEOUT_MS=30000
OCR_CLI_TIMEOUT_MS=45000
OCR_MIN_TEXT_LENGTH=4
OCR_RECONNECT_DELAY_MS=3000
SAVE_CAPTCHA_DATASET=true

# Storage Paths (defaults resolve relative to DATA_DIR or current working directory)
DATA_DIR=.
# DOWNLOADS_DIR=./downloads
# CAPTCHAS_DIR=./captchas
# LOGS_DIR=./logs
# COMBINATIONS_FILE=./combinations.json
# STATE_FILE=./tasks-state.json

# Combinations Crawler CLI
FETCH_CONCURRENCY=5
FETCH_DELAY_MS=200
FETCH_RETRIES=3

